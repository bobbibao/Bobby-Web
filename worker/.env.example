NODE_ENV=
LOGGING_LEVEL=
LOGGING_DAYS=
LOGGING_FOLDER_PATH=

# Bobby Python AI Model Service
BOBBY_AI_API_URL=https://genimageapi.dpdns.org
BOBBY_AI_TIMEOUT=1800000
BOBBY_AI_FORCE=true

# Google Cloud Storage
BOBBY_GCP_PROJECT_ID=
BOBBY_GCP_PRIVATE_KEY_ID=
BOBBY_GCP_PRIVATE_KEY=
BOBBY_GCP_CLIENT_EMAIL=
BOBBY_GCP_CLIENT_ID=
BOBBY_GCS_BUCKET_NAME=

# Server API webhooks
IMAGE_GENERATION_WEBHOOK_URL=http://localhost:3000/api/image-generation/generate-webhook
IMAGE_GENERATION_WEBHOOK_SECRET=
IMAGE_EDIT_WEBHOOK_URL=http://localhost:3000/api/image-edit/edit-webhook
IMAGE_EDIT_WEBHOOK_SECRET=

# Redis / queues
REDIS_HOST=
REDIS_PORT=
REDIS_ENABLE_READY_CHECK=true
REDIS_LAZY_CONNECT=true
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=
WORKER_CONCURRENCY=4

POLLING_TIMEOUT_MINUTES=
POLLING_INTERVAL_SECONDS=
